meta {
  name: Register development user
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  const runId = Date.now().toString()
  bru.setVar("email", `bruno-user-${runId}@example.test`)
  bru.setVar("sku", `BRUNO-${runId}`)
}

assert {
  res.status: eq 200
}
