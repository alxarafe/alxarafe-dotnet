meta {
  name: Login reader seed
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{readerEmail}}",
    "password": "{{readerPassword}}"
  }
}

script:post-response {
  bru.setVar("token", res.body.accessToken)
}

assert {
  res.status: eq 200
}
