meta {
  name: Login development user
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setVar("token", res.body.accessToken)
}

assert {
  res.status: eq 200
  res.body.accessToken: isString
}
