meta {
  name: Identity validation in Spanish preserves framework codes
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Accept-Language: es
}

body:json {
  {
    "email": "{{validationEmail}}",
    "password": "Abcd1!"
  }
}

script:pre-request {
  bru.setVar("validationEmail", `i18n-${Date.now()}@example.test`);
}

assert {
  res.status: eq 400
  res.body.status: eq 400
  res.body.title: eq Se produjeron uno o más errores de validación.
}

tests {
  test("Identity localizes only human validation messages", function () {
    expect(res.getHeader("content-type")).to.include("application/problem+json");
    expect(Object.keys(res.body).sort()).to.deep.equal(["errors", "status", "title", "traceId", "type"]);
    expect(Object.keys(res.body.errors)).to.deep.equal(["PasswordTooShort"]);
    expect(res.body.errors.PasswordTooShort).to.deep.equal(["Las contraseñas deben tener al menos 8 caracteres."]);
  });
}
