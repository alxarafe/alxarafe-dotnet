meta {
  name: Catalog duplicate item in Spanish
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/catalog/items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{creatorToken}}
}

headers {
  Accept-Language: es
}

body:json {
  {
    "sku": "{{sku}}",
    "name": "Duplicate item"
  }
}

assert {
  res.status: eq 409
  res.body.status: eq 409
  res.body.code: eq catalog.sku_already_exists
  res.body.title: eq Ya existe un artículo con este SKU.
}
