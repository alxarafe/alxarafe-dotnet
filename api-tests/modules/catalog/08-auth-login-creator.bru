meta {
  name: Login creator seed
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{creatorEmail}}",
    "password": "{{creatorPassword}}"
  }
}

script:pre-request {
  bru.setVar("sku", `BRUNO-${Date.now()}`)
}

script:post-response {
  bru.setVar("creatorToken", res.body.accessToken)
}

assert {
  res.status: eq 200
}
