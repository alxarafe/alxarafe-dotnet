meta {
  name: Catalog unsupported language falls back to English
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/catalog/items/00000000-0000-0000-0000-000000000001
  body: none
  auth: bearer
}

auth:bearer {
  token: {{readerToken}}
}

headers {
  Accept-Language: fr
}

assert {
  res.status: eq 404
  res.body.status: eq 404
  res.body.code: eq catalog.item_not_found
  res.body.title: eq The requested catalog item was not found.
}

tests {
  test("Language changes preserve the technical ProblemDetails shape", function () {
    expect(res.getHeader("content-type")).to.include("application/problem+json");
    expect(Object.keys(res.body).sort()).to.deep.equal(["code", "status", "title", "traceId", "type"]);
  });
}
