meta {
  name: Prepare reader session for Catalog GET
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{readerEmail}}",
    "password": "{{readerPassword}}"
  }
}

script:post-response {
  bru.setVar("readerToken", res.body.accessToken)
}

assert {
  res.status: eq 200
}
