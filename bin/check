#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

source ./bin/validation-db

cleanup() {
    local result=$?
    trap - EXIT
    validation_host_stop
    if ! validation_db_drop || ! validation_db_removed; then
        echo "ERROR: ephemeral databases could not be removed" >&2
        result=1
    fi
    exit "$result"
}

diagnostics() {
    echo "==> Docker diagnostics"
    docker compose ps || true
    docker compose logs --no-color validation-app postgres || true
}

trap diagnostics ERR

echo "==> Validating Docker Compose configuration"
docker compose config >/dev/null
echo "==> Building validation image and starting PostgreSQL"
docker compose build app
docker compose up -d postgres
trap cleanup EXIT
validation_host_stop
validation_db_create

echo "==> Running .NET restore, build, and tests"
./bin/test --prepared

echo "==> Starting isolated validation Host"
docker compose up -d --wait validation-app

echo "==> Checking health endpoint from the validation network"
docker compose exec -T validation-app curl --fail --silent --show-error http://localhost:8080/health >/dev/null

echo "==> Checking OpenAPI from the validation network"
openapi="$(docker compose exec -T validation-app curl --fail --silent --show-error http://localhost:8080/openapi/v1.json)"
grep -Fq '"/api/auth/register"' <<<"$openapi"
grep -Fq '"/api/auth/login"' <<<"$openapi"
grep -Fq '"/api/catalog/items' <<<"$openapi"

echo "==> Running the 14 Bruno API scenarios"
./bin/bruno --prepared

echo "==> Verifying persisted data in PostgreSQL"
docker compose exec -T postgres psql -U alxarafe -d "$validation_catalog_db" -tAc \
    "SELECT to_regclass('public.catalog_items')" | grep -Fxq 'catalog_items'
docker compose exec -T postgres psql -U alxarafe -d "$validation_catalog_db" -tAc \
    "SELECT 1 FROM catalog_items WHERE \"Name\" = 'Bruno item'" | grep -Fxq '1'
docker compose exec -T postgres psql -U alxarafe -d "$validation_security_db" -tAc \
    "SELECT 1 FROM information_schema.tables WHERE table_name = 'AspNetUsers'" | grep -Fxq '1'
docker compose exec -T postgres psql -U alxarafe -d "$validation_security_db" -tAc \
    "SELECT COUNT(*) FROM \"AspNetUsers\" WHERE \"Email\" IN ('reader@example.test', 'creator@example.test')" | awk '{ if ($1 < 2) exit 1 }'

echo "==> Checking validation application logs for known sensitive values"
app_logs="$(docker compose logs --no-color validation-app)"
if grep -Fq 'Reader_dev_only_123!' <<<"$app_logs" || \
   grep -Fq 'Creator_dev_only_123!' <<<"$app_logs" || \
   grep -Fq 'Password123' <<<"$app_logs" || \
   grep -Eiq 'accessToken|Bearer[[:space:]]+[A-Za-z0-9._~-]{20,}' <<<"$app_logs"; then
    echo "ERROR: a password or bearer token marker was written to application logs" >&2
    exit 1
fi

echo
echo "VALIDATION PASS: Compose, .NET, API, Bruno, PostgreSQL, and architecture checks completed"
