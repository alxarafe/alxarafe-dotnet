# Local development configuration. Keep the populated file local; never commit it.
# Docker Compose reads .env; a template alone is not loaded.
# Never commit a real credential.

# Local CORE administrator. Set a new local-only password before starting.
ERBAS_CORE_ADMIN_EMAIL=admin@example.test
ERBAS_CORE_ADMIN_PASSWORD=

# Optional WMS development reader. Explicit password enables provisioning.
# Receives warehouse/location/item/inventory READ only; no movements or WRITE.
ERBAS_WMS_USER_EMAIL=user@example.test
ERBAS_WMS_USER_PASSWORD=

# Compose uses a synthetic development tenant with a separate business database.
# Production requires explicit registry/membership and ConnectionStrings__Tenant_<reference>
# supplied through external configuration/secrets; see docs/tenancy.md.

# Backend-only live AI provider configuration for Development.
# CI and shared conformance use the deterministic adapter and need no key.
AI_GROQ_API_KEY=
AI_PROVIDER=groq
AI_MODEL=qwen/qwen3.8-27b
AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_GROQ_TIMEOUT_SECONDS=60

# Optional local Ollama (no API key). Loopback-only Ollama requires the documented
# host-network smoke setup; 127.0.0.1 inside a bridge container is not the host.
# AI_PROVIDER=ollama
# AI_MODEL=gemma4:latest
# AI_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# AI_OLLAMA_TIMEOUT_SECONDS=1800

# Optional host port override; the default is 48081.
# ERBAS_DOTNET_PORT=48081

# Opt-in fictional Assets dataset; never enabled by Development alone.
# See docs/assets-demo-data.md. Normal validation stays demo-free.
ERBAS_ASSETS_DEMO_DATA=false
