{
    "name": "Alxarafe.NET",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "app",
    "runServices": ["postgres", "app"],
    "workspaceFolder": "/workspace",
    "overrideCommand": true,
    "shutdownAction": "none",
    "forwardPorts": [],
    "portsAttributes": {
        "8080": {
            "label": "Alxarafe.NET development API",
            "onAutoForward": "ignore"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csharp",
                "ms-dotnettools.csdevkit"
            ]
        }
    },
    "postCreateCommand": "dotnet restore Alxarafe.sln"
}
